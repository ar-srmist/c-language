#include <stdio.h>
int main()
{
char ch;
printf("enter any character:");
scanf("%c", &ch);
if(ch >= 'A' && ch <= 'Z'){
    printf("uppercase letter.\n");
}
else if (ch >= 'a' && ch <= 'z'){
    printf("lowercase letter.\n");
} 
else if (ch >= '0' && ch<='9'){
    printf("digit.\n");
}
else{
    printf("special character.\n");
}
    return 0;
}



